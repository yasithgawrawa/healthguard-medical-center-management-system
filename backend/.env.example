PORT=5000
# Local development: mongodb://127.0.0.1:27017/healthguard
# Production Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/healthguard?appName=healthguard
MONGODB_URI=mongodb://127.0.0.1:27017/healthguard
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
