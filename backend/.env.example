# Shared Environment Settings | Configuration | Set the backend HTTP listening port.
PORT=5000
# Local development: mongodb://127.0.0.1:27017/healthguard
# Production Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/healthguard?appName=healthguard
# Select the MongoDB connection used by the backend and maintenance scripts.
MONGODB_URI=mongodb://127.0.0.1:27017/healthguard
# Supply the private signing secret used to issue and verify authentication tokens.
JWT_SECRET=replace_with_a_long_random_secret
# Set how long issued JWTs remain valid.
JWT_EXPIRES_IN=1d
# Allow this frontend origin through the backend CORS configuration.
CLIENT_ORIGIN=http://localhost:5173
